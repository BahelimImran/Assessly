MAX_UPLOAD_SIZE_MB=25
MAX_ACTIVE_JOBS_PER_USER=3
QUERY_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_WINDOW_SECONDS=60
LLM_CONCURRENCY_LIMIT=2
LLM_CONCURRENCY_TTL_SECONDS=900

JOB_TTL_SECONDS=86400
JOB_STREAM_RECLAIM_IDLE_MS=3600000
JOB_STREAM_BLOCK_MS=5000

MODEL_REQUEST_RETRIES=2
MODEL_REQUEST_BACKOFF_SECONDS=1.0
EMBED_REQUEST_TIMEOUT_SECONDS=120
EMBED_BATCH_REQUEST_TIMEOUT_SECONDS=300
LLM_REQUEST_TIMEOUT_SECONDS=300
VISION_REQUEST_TIMEOUT_SECONDS=180

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

JWT_SECRET_KEY=Assessly@786@
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
DEMO_USER_ID=demo_user
GUEST_QUERY_RATE_LIMIT_PER_MINUTE=5