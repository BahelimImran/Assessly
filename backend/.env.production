QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=assessly
POSTGRES_USER=assessly
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT_PUBLISHED=5432
